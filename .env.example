# Swavy Dispatch settings. Copy this file to ".env" (same folder as start.bat) and change what you need.
# Lines starting with # are ignored. Restart the app after changing anything.

# Web address port: http://localhost:3002 (if it is busy, the next free port is used)
PORT=3002

# 127.0.0.1 keeps the app on this computer only.
# HOST=0.0.0.0 lets phones on the same Wi-Fi open it (riders can test on their phones).
HOST=127.0.0.1

# Password for the dispatcher / admin page (#/admin). PLEASE CHANGE IT.
ADMIN_PASSWORD=swavyadmin

# Telegram bot. Leave empty to keep the bot off (you can still try it at /bot-test).
# Get a token from @BotFather in Telegram, paste it after the = sign, then restart.
TELEGRAM_BOT_TOKEN=

# Optional: the public web address of this app, so tracking links in Telegram messages are clickable.
# Example: PUBLIC_URL=https://dispatch.swavy.ng
PUBLIC_URL=

# Speed of the simulated rider dot on the map. 1 = normal, 2 = faster, 0 = off.
SIM_SPEED=1

# Folder for the database and uploaded photos.
DATA_DIR=data

# Days a login lasts.
SESSION_DAYS=30

# SEED=1 fills a brand-new database with SAMPLE demo data. SEED=0 starts empty (areas and sample prices are still added).
SEED=1
QUIET=0
